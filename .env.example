# Server port (the web app proxies /api to it)
PORT=8787

# whisper.cpp binary. Homebrew's whisper-cpp installs it as `whisper-cli`.
WHISPER_BIN=whisper-cli

# Model file, relative to the repo root. Run `npm run setup:whisper` to download.
# Options: ggml-base.en.bin (fastest), ggml-small.en.bin (default), ggml-medium.en.bin (most accurate)
WHISPER_MODEL=models/ggml-small.en.bin

# Use the Mac's GPU (Metal). If whisper.cpp crashes on the GPU, Voice Out retries on the CPU automatically;
# set this to false to skip the GPU attempt entirely.
WHISPER_GPU=true

# ---- Cleanup: set ONE of these keys ----

# Gemini (has a free tier): get a key at https://aistudio.google.com/apikey
# Note: on the free tier, Google may use what you send to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried once if the main model is busy or out of free quota (each model has its own). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude (paid, a fraction of a cent per memo): get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Haiku is fast and cheap; switch to claude-sonnet-5-5 for harder memos.
CLAUDE_MODEL=claude-haiku-5-5

# If both keys are set, Claude is used. Set this to gemini or claude to choose.
CLEANUP_PROVIDER=
