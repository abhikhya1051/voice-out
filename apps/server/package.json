{
  "name": "@voice-out/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:demo": "VOICE_OUT_DEMO=1 tsx watch src/index.ts",
    "eval": "tsx src/evals/run.ts",
    "dev:capture": "VOICE_OUT_CAPTURE=1 tsx watch --exclude ../../demo src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/multipart": "^9.0.1",
    "@google/genai": "^2.32.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
