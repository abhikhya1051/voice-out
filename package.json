{
  "name": "voice-out",
  "version": "0.1.0",
  "private": true,
  "description": "Ramble into your mic; get a clean note back. Local Whisper transcription + Claude filler cleanup.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @voice-out/server\" \"npm run dev -w @voice-out/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "setup:whisper": "bash scripts/setup-whisper.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
